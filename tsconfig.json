{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": false,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noErrorTruncation": true,
    "noEmit": true,
    "paths": {
      "@peculiar/color": ["./packages/color/src"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/react-components/.storybook",
    "packages/react-components/vitest.setup.ts",
    "*.config.ts"
  ]
}
